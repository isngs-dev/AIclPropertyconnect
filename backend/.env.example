# Dummy-database default (SQLite). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://aicl:aicl@localhost:5432/aicl
DATABASE_URL=sqlite:///./aicl.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:3120
CORS_ORIGINS=http://localhost:3120
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ENABLE_SCHEDULER=true
# Payments: mock (built-in simulated gateway) | paystack (Nigeria, test mode)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MOCK_WEBHOOK_SECRET=mock-webhook-secret
# Email (leave SMTP_HOST empty to log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
